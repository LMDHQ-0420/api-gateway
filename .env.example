HOST=127.0.0.1
PORT=3000
PROVIDERS_FILE=providers.json
# 兼容旧版 GLM 池：仅当 keys/glm/keys.txt 为空时读取此文件。
KEYS_FILE=keys.txt
# 可选：覆盖 GLM 上游 origin；其他厂商在 providers.json 配置。
# UPSTREAM_ORIGIN=https://open.bigmodel.cn
# 每次尝试从建连到响应头的硬性上限；收到响应头后为相邻数据的空闲超时（毫秒）。
UPSTREAM_TIMEOUT_MS=120000
# 每个厂商完整查询模型列表的总时间上限，毫秒；各厂商并行查询。
MODELS_TIMEOUT_MS=10000
MAX_BODY_BYTES=33554432
# 402/429 按模型及接口冷却；401 跨接口冷却。设为 0 关闭对应冷却。
KEY_COOLDOWN_MS=30000
AUTH_COOLDOWN_MS=300000
# GLM 1302 短限流、1308/1310 无明确重置时间、1113 欠费的冷却毫秒数。
RATE_COOLDOWN_MS=5000
QUOTA_COOLDOWN_MS=900000
BALANCE_COOLDOWN_MS=3600000
# 可选：设置后，客户端 Authorization: Bearer 使用这个网关口令。
# 留空时接受客户端原有的 Authorization；发往官方时统一换成队列中的 key。
GATEWAY_TOKEN=
